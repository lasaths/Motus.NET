<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="two_link">
  <xacro:property name="link_len" value="0.2"/>
  <link name="base_link"/>
  <link name="link1">
    <visual>
      <origin xyz="0.1 0 0" rpy="0 0 0"/>
      <geometry><box size="0.2 0.04 0.04"/></geometry>
    </visual>
  </link>
  <link name="tip_link">
    <visual>
      <geometry><sphere radius="0.035"/></geometry>
    </visual>
  </link>
  <xacro:include filename="two_link_joints.xacro"/>
</robot>
