<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="${prefix}mini_ur_style">
  <xacro:property name="link_len" value="0.24"/>
  <xacro:property name="tool_z" value="0.08"/>

  <link name="${prefix}base_link"/>

  <xacro:macro name="mini_arm" params="prefix length">
    <link name="${prefix}upper_arm_link"/>
    <link name="${prefix}tip_link"/>
    <joint name="${prefix}shoulder_pan_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}upper_arm_link"/>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159" upper="3.14159" velocity="1.4"/>
    </joint>
    <joint name="${prefix}elbow_joint" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child link="${prefix}tip_link"/>
      <origin xyz="${length} 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.0" upper="2.0" velocity="1.2"/>
    </joint>
  </xacro:macro>

  <xacro:mini_arm prefix="${prefix}" length="${link_len}"/>
  <xacro:include filename="tool_link.xacro"/>
</robot>
