<?xml version="1.0"?>
<!--
  Experimental HolonomicSE3 free-flyer for Motus 2.1 pass-off (not PX4 / MAVLink).
  Single link (base==tip) with multi-visual quadrotor silhouette for Preview.
-->
<robot name="free_flyer_box">
  <link name="body">
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
    <!-- Collision hull (planning) -->
    <collision name="hull">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.22 0.08"/>
      </geometry>
    </collision>
    <!-- Central body -->
    <visual name="fuselage">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.10 0.05"/>
      </geometry>
      <material name="body_teal">
        <color rgba="0.15 0.55 0.55 1"/>
      </material>
    </visual>
    <!-- Arms -->
    <visual name="arm_px">
      <origin xyz="0.12 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.02 0.015"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.12 0.14 0.16 1"/>
      </material>
    </visual>
    <visual name="arm_nx">
      <origin xyz="-0.12 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.02 0.015"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.12 0.14 0.16 1"/>
      </material>
    </visual>
    <visual name="arm_py">
      <origin xyz="0 0.12 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.16 0.015"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.12 0.14 0.16 1"/>
      </material>
    </visual>
    <visual name="arm_ny">
      <origin xyz="0 -0.12 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.16 0.015"/>
      </geometry>
      <material name="arm_dark">
        <color rgba="0.12 0.14 0.16 1"/>
      </material>
    </visual>
    <!-- Rotors -->
    <visual name="rotor_px">
      <origin xyz="0.20 0 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.008"/>
      </geometry>
      <material name="rotor">
        <color rgba="0.25 0.28 0.32 1"/>
      </material>
    </visual>
    <visual name="rotor_nx">
      <origin xyz="-0.20 0 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.008"/>
      </geometry>
      <material name="rotor">
        <color rgba="0.25 0.28 0.32 1"/>
      </material>
    </visual>
    <visual name="rotor_py">
      <origin xyz="0 0.20 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.008"/>
      </geometry>
      <material name="rotor">
        <color rgba="0.25 0.28 0.32 1"/>
      </material>
    </visual>
    <visual name="rotor_ny">
      <origin xyz="0 -0.20 0.022" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.008"/>
      </geometry>
      <material name="rotor">
        <color rgba="0.25 0.28 0.32 1"/>
      </material>
    </visual>
  </link>
</robot>
