<?xml version="1.0"?>
<!--
  Meshless aerial free-flyer hull for SE(3) collision / preview smoke.
  Motus-honest: rigid body + Family=aerial planning only — not PX4 / MAVLink / propulsion.
-->
<robot name="free_flyer_box">
  <link name="body">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision name="hull">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.08"/>
      </geometry>
    </collision>
    <visual name="hull_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.2 0.2 0.08"/>
      </geometry>
    </visual>
  </link>
</robot>
