@page "/bamboo-truss"
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Motus.Core
@using Motus.Geometry
@using Motus.Presets
@using Motus.Construction
@using System.Text.Json
@using System.Xml.Linq

<PageTitle>Bamboo truss · ANDURA</PageTitle>

@* ANDURA L1 "3D dominant". One question: where is the truss build, and is the Motus plan clear?
   Persistent zones: top line, alarm band (only while a P1/P2 is active), footer = timeline bar. *@
<div class="andura viewer-container" data-motus="@_motusState" data-alarms="@(HasAlarm ? "1" : null)">
    <header class="top">
        <span class="label text">ANDURA</span>
        <h1 class="h1 trunc" tabindex="-1" title="Bamboo truss · Warren truss over a pit">Bamboo truss · Warren over pit</h1>
        <span class="facts">
            <span class="label">CONTROL <span class="text">LOCAL</span></span>
            <span class="label live">DATA <span class="text">PLAN REPLAY</span></span>
            <span class="label text value" id="andura-clock"></span>
        </span>
    </header>

    @if (HasAlarm)
    {
        <section class="band" aria-label="Active alarms">
            @if (IsStop)
            {
                <div class="r p1"><span class="edge"></span>
                    <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 0h6l5 5v6l-5 5H5l-5-5V5z" style="fill:var(--andura-color-emergency)"/><path d="M7 3h2v6H7zM7 11h2v2H7z" style="fill:var(--andura-color-void)"/></svg>
                    <span class="label text value">P1 EMERGENCY</span>
                    <span class="trunc" title="@StopText">@StopText</span>
                    <span class="label value ack-state">@(_motusState == "manual-hit" ? "MANUAL" : $"AT {_t * 100:F1} %") · <span class="ack-word">UNACK</span></span>
                    <span class="acts"><button type="button" class="btn hit" onclick="anduraConfirmAck()">ACKNOWLEDGE</button></span>
                </div>
            }
            @if (!string.IsNullOrEmpty(CautionText))
            {
                <div class="r p2"><span class="edge"></span>
                    <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0l8 15H0z" style="fill:var(--andura-color-caution)"/><path d="M7 5h2v5H7zM7 11h2v2H7z" style="fill:var(--andura-color-void)"/></svg>
                    <span class="label text value">P2 CAUTION</span>
                    <span class="muted trunc" title="@CautionText">@CautionText</span>
                    <span class="label value">PLAN</span>
                </div>
            }
        </section>
        <dialog id="ack" aria-labelledby="ack-t">
            <span class="title" id="ack-t">Acknowledge P1 · Motus stop?</span>
            <p class="muted">Acknowledging stops the pulse. It does not clear the collision; edit the plan or press RESET.</p>
            <div class="acts"><button type="button" class="btn hit" autofocus onclick="document.getElementById('ack').close()">CANCEL</button><button type="button" class="btn pri hit" onclick="anduraAcked()">ACKNOWLEDGE P1</button></div>
        </dialog>
    }

    <main class="main">
        <div class="viewport-wrap viewport">
            <div id="viewport"></div>
            <div class="legend label">DRAG TO ORBIT · <span class="text">RING</span> CLAMPED · <span class="accent">RING</span> CANE IN HAND@(IsStop ? " · " : "")@if (IsStop) {<span class="em">RED</span><span> MOTUS HIT</span>}</div>
        </div>

        <aside class="controls col">
            <div class="cellsum">
                <span class="label">TRUSS · 7 MEMBERS</span>
                <div class="row alarm-only">
                    @if (IsStop)
                    {
                        <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 0h6l5 5v6l-5 5H5l-5-5V5z" style="fill:var(--andura-color-emergency)"/><path d="M7 3h2v6H7zM7 11h2v2H7z" style="fill:var(--andura-color-void)"/></svg>
                        <span class="title trunc" title="P1 · Motus stop">P1 · Motus stop</span>
                    }
                    else
                    {
                        <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0l8 15H0z" style="fill:var(--andura-color-caution)"/><path d="M7 5h2v5H7zM7 11h2v2H7z" style="fill:var(--andura-color-void)"/></svg>
                        <span class="title trunc" title="P2 · Plan issue">P2 · Plan issue</span>
                    }
                </div>
                <div class="normal-only"><span class="title">@StatusTitle</span></div>
                <p class="phase muted trunc @(!string.IsNullOrEmpty(_motionError) || _collision ? "err" : "")" data-motus="@_motusState" title="@_phase">@_phase</p>
            </div>

            <div class="kpi @(HasAlarm ? "dim" : "")">
                <span class="label">MEMBERS PLACED</span>
                <div class="kpi-v">
                    @if (IsRobotReady)
                    {
                        <span class="value display">@MembersDone</span><span class="muted value vm">/ @MembersTotal</span>
                    }
                    else
                    {
                        <span class="value display muted">—</span>
                    }
                </div>
                <span class="vals"><span class="label value">@(IsRobotReady ? ActiveMemberText : "WAITING FOR DATA")</span></span>
                <div class="bar"><span style="width:@((MembersTotal == 0 ? 0 : 100.0 * MembersDone / MembersTotal).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
            </div>

            <details class="sect" open>
                <summary class="hit label">TASKS · @_tasks.Count <span class="chev">›</span></summary>
                <div id="tasks">
                    @for (var ti = 0; ti < _tasks.Count; ti++)
                    {
                        var index = ti;
                        var task = _tasks[index];
                        var used = IsMotionTask(index);
                        var canDelete = CanDelete(task);
                        <div class="task">
                            <div class="taskhead">
                                <span class="text trunc" title="@TaskTitle(task)">@TaskTitle(task)</span>
                                <span class="used">@(task.Identity == "walk" ? (task.Gait == BambooTrussMotion.LandGait ? "walk · land" : $"walk · {BambooWalk.GaitNamed(task.Gait).Name}") : task.Identity == "park" ? "relay" : used ? "motion" : "")</span>
                            </div>
                            <div class="field">
                                <span>identity</span>
                                <input value="@task.Identity" @oninput="e => OnIdentity(index, e)" />
                            </div>
                            <div class="field">
                                <span>object</span>
                                <input value="@task.Object" @oninput="e => OnObject(index, e)" />
                            </div>
                            <div class="field">
                                <span>jaw</span>
                                <input type="number" step="1" value="@task.JawMm" @oninput="e => OnJawMm(index, e)" />
                                <em>mm</em>
                            </div>
                            @if (task.Identity == "walk")
                            {
                                <div class="field">
                                    <span>gait</span>
                                    <select value="@(task.Gait ?? BambooWalk.Default.Id)" @onchange="e => OnGait(index, e)">
                                        @foreach (var g in BambooWalk.Gaits)
                                        {
                                            <option value="@g.Id">@g.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            @foreach (var plane in task.Planes)
                            {
                                var pname = plane.Name;
                                <div class="field">
                                    <span class="trunc" title="@pname">@pname</span>
                                    <input type="number" step="0.5" title="Nudge @pname along world Y, millimetres"
                                           value="@plane.YMm"
                                           @oninput="e => OnPlaneYMm(index, pname, e)" />
                                    <em>mm</em>
                                </div>
                            }
                            <div class="btns">
                                <button type="button" class="btn mini hit" @onclick="() => DuplicateTask(index)">DUPLICATE</button>
                                <button type="button" class="btn mini hit" disabled="@(!canDelete)" @onclick="() => DeleteTask(index)">DELETE</button>
                            </div>
                        </div>
                    }
                </div>
            </details>

            @if (!string.IsNullOrEmpty(_motionError))
            {
                <p class="warn">@_motionError</p>
            }
            @if (_planNotes.Count > 0)
            {
                <details class="sect">
                    <summary class="hit label">PLAN NOTES · @_planNotes.Count <span class="chev">›</span></summary>
                    <ul class="note plan-notes">
                        @foreach (var n in _planNotes)
                        {
                            <li>@n</li>
                        }
                    </ul>
                </details>
            }
            @if (!string.IsNullOrEmpty(_motusNote))
            {
                <p class="warn motus-hit">@_motusNote</p>
            }

            <details class="sect">
                <summary class="hit label">MANUAL JOG <span class="chev">›</span></summary>
                <p class="note">Moving a slider pauses playback and drives the arm from C#.</p>
                @if (!IsRobotReady)
                {
                    <div class="joint-loading label">@(_initError ?? "Loading Motus.NET…")</div>
                }
                else
                {
                    @for (var i = 0; i < 5; i++)
                    {
                        var ji = i;
                        <div class="row jog">
                            <label class="label">θ@(ji + 1) <span class="value text">@_qDeg[ji].ToString("F1")°</span></label>
                            <input type="range" class="hit"
                                   min="@BambooIcdMotion.LimitsDeg[ji].Min"
                                   max="@BambooIcdMotion.LimitsDeg[ji].Max"
                                   step="0.1"
                                   value="@_qDeg[ji]"
                                   @oninput="e => OnJoint(ji, e)" />
                        </div>
                    }
                    <div class="row jog">
                        <label class="label">L-GRIP <span class="value text">@_gL.ToString("F1") <span class="muted unit">mm</span></span></label>
                        <input type="range" class="hit" min="8" max="45" step="0.1" value="@_gL" @oninput="OnGripL" />
                    </div>
                    <div class="row jog">
                        <label class="label">R-GRIP <span class="value text">@_gR.ToString("F1") <span class="muted unit">mm</span></span></label>
                        <input type="range" class="hit" min="8" max="45" step="0.1" value="@_gR" @oninput="OnGripR" />
                    </div>
                }
            </details>

            <label class="check hit label">
                <input type="checkbox" checked="@_axesVisible" @onchange="OnAxesToggle" /> JOINT AXES
            </label>

            <details class="sect">
                <summary class="hit label">ABOUT THIS CELL <span class="chev">›</span></summary>
                <p class="note">Three-triangle Warren truss A–M–D / T1–T2 over a U-shaped pit, all members in one plane with node connectors (0.24 m canes = 0.30 m panel − 2 × 30 mm gap). No stakes: the arm starts on the pin column at A and moves on what it builds. All 7 members, in the order a build search derives from the structure graph and the reach map (each step confirmed by the planner): triangle 1 (A–T1, T1–M, A–M) from the A column, T1–T2 and M–D after targeted-landing walks, M–T2 from there, T2–D through one relay (its cane parked in T1's connector, re-grasped after a second landing). One gripper is always clamped on a fixed object (anchor column or a member of the rigid anchored subframe) and is the IK base; Motus.NET owns FK/IK/collision; Three.js only draws.</p>
                <p class="note">
                    Play runs every pick/place pair (object = member id). Footprint: one vertical plane (z 0.11), A–M–D at support level, apexes T1 / T2.
                    Bend axes local X, wrists local Y, jaws local X. Viewer is Three.js Y-up; Motus.NET URDF is Z-up (shared θ).
                    Ground surfaces outside A and D; the pit (two walls + floor, 0.25 m deep) between them; no earth inside the span. Start: L-grip clamped on the anchor column under A (grey ring + label on every clamped gripper; ultramarine = cane in hand). From there the R-grip picks each cane off the stock (flat, next to A outside the pit) and places A–T1, T1–M, A–M; every placement ends with R parked. Before each further member a "land" walk block moves L (R clamps a fixed member, swap, L backs off sideways, L side-clamps the chosen point/roll, swap, R parks) to a spot from which the stock and the place are both reachable: T1–T2, M–D; M–T2 is reachable from where M–D left the arm (closes triangle 2). T2–D: park its cane in T1's connector (slides in along its axis), walk, re-grasp, pull out along the axis, place.
                    Collision: Motus.NET for every link, both grippers, the mount, the held cane, ground, pit walls and floor, anchor columns, node connectors, pegs, placed canes and self; the only allowed touch is a gripper's jaw plates on what it clamps. Play/scrub never pass the Motus-verified frontier.
                </p>
            </details>
        </aside>
    </main>

    <footer class="timeline foot" data-motus="@_motusState">
        <div class="tl-controls">
            <button type="button" class="btn hit @(_isPlaying ? "active" : "")" disabled="@(!IsRobotReady)" @onclick="TogglePlay">
                @(_isPlaying ? "PAUSE" : "PLAY")
            </button>
            <button type="button" class="btn hit" disabled="@(!IsRobotReady)" @onclick="ResetAll">RESET</button>
            <div class="tl-readout">
                <span class="tl-pct value">@(_t * 100 >= 99.95 ? "100" : (_t * 100).ToString("F1"))<span class="muted"> %</span></span>
            </div>
        </div>
        <div class="tl-body">
            <div class="tl-blocks">
                @foreach (var b in _blocks)
                {
                    var blk = b;
                    <div class="tl-block tl-@blk.Kind @(blk.T0 <= _t && _t < blk.T1 ? "on" : "")" title="@($"{blk.Label} · {blk.T0 * 1000:F0}–{blk.T1 * 1000:F0}")"
                         style="left:@((blk.T0 * 100).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%;width:@(((blk.T1 - blk.T0) * 100).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%"
                         @onclick="() => JumpTo(blk.T0)">
                        <span>@blk.Label</span>
                    </div>
                }
                <div class="tl-playhead" style="left:@((_t * 100).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <div class="tl-track">
                <div class="tl-fill" style="width:@((_t * 100).ToString("F3", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                <input type="range" class="tl-scrub hit" min="0" max="1000" step="1" value="@_scrub"
                       disabled="@(!IsRobotReady)" @oninput="OnScrub" aria-label="Motion" />
            </div>
        </div>
        <span class="estop label">E-STOP: PHYSICAL ONLY</span>
    </footer>
</div>

@code {
    private List<string> _planNotes = new();
    private BambooIcdCell? _cell;
    private CancellationTokenSource? _scanCts;

    private List<BambooIcdMotion.TaskEdit> _tasks = BambooTrussMotion.ShippedTasks();
    private List<BambooIcdMotion.MotionKey> _keys = new();
    private List<BambooTrussMotion.CycleBound> _cycles = new();
    private List<BambooTrussTimeline.Block> _blocks = new();
    private BambooTrussScan? _trussScan;
    private string _motionError = "";
    private string _motusNote = "";

    private double[] _qDeg = BambooIcdMotion.HomeDeg.ToArray();
    private double _gL = BambooTrussLayout.JawClosedMm;
    private double _gR = 40;
    private int _hold;
    private string _label = "Home";
    private bool _axesVisible = true;
    private bool _collision;
    private IReadOnlyList<CollisionContact> _contacts = Array.Empty<CollisionContact>();
    private string _phase = "Home";
    private int _scrub;
    /// <summary>Exact motion time (0..1); <see cref="_scrub"/> is only the slider's rounded view of it.</summary>
    private double _t;
    private BambooTrussPlayback? _playback;
    private int _scrubPct => (int)Math.Round(_scrub / 10.0);
    private bool _isPlaying;
    private bool _manual;
    private bool _robotReady;
    private string? _initError;
    private bool _threeReady;
    private CancellationTokenSource? _playCts;

    /// <summary>Plain-text status for automation / screenshots: clear | stopped | manual-hit.</summary>
    private string _motusState = "clear";

    private bool IsRobotReady =>
        _robotReady && _qDeg.Length >= 5 && _threeReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await InitializeRobot();
        if (_cell is not null)
        {
            try
            {
                var merged = new Dictionary<string, object?>
                {
                    ["seg"] = _cell.Seg,
                    ["poleY"] = BambooIcdMotion.PoleY,
                    ["includePole"] = false,
                    ["pole"] = new { radius = BambooIcdCell.PoleRadius, length = BambooIcdCell.PoleLength, segments = BambooIcdCell.PoleSegments },
                    ["strut"] = new { radius = BambooIcdCell.StrutRadius, length = _cell.StrutLen, segments = BambooIcdCell.StrutSegments },
                    // Motus collides the two ground surfaces outside the pit: draw exactly those, not a full slab.
                    ["ground"] = new
                    {
                        size = BambooIcdCell.GroundSize,
                        pads = BambooTrussLayout.Pads.Select(p => new { name = p.Name, x = p.X, z = p.Z, half = Math.Max(p.HalfX, p.HalfZ), halfX = p.HalfX, halfZ = p.HalfZ }).ToArray()
                    },
                    ["posts"] = BambooTrussLayout.Posts.Select(p => new { name = p.Name, x = p.X, z = p.Z, top = p.Top, radius = p.Radius }).ToArray(),
                    ["pit"] = BambooTrussLayout.PitBoxes.Select(b => new { name = b.Name, x = b.X, y = b.Y, z = b.Z, halfX = b.HalfX, halfY = b.HalfY, halfZ = b.HalfZ }).ToArray(),
                    ["hubs"] = BambooTrussLayout.FootNodes.Select(n => new { node = n.Name, x = n.X, y = n.Y, z = n.Z, half = BambooTrussLayout.HubHalf, @fixed = n.Name is "A" or "D" }).ToArray(),
                    ["racks"] = BambooTrussLayout.Racks.Select(r => new { name = r.Name, x = r.X, z = r.Z, halfX = r.HalfX, halfZ = r.HalfZ, top = r.Top }).ToArray(),
                    ["parts"] = _cell.Parts.Select(p => new { name = p.Name, link = p.Link, size = p.Size, pos = p.Pos }),
                    ["footprint"] = BambooTrussLayout.FootprintDescription(),
                    ["store"] = BambooTrussLayout.StoreDescription()
                };
                await JS.InvokeVoidAsync("initThreeJs", JsonSerializer.Serialize(merged));
                _threeReady = true;
            }
            catch (JSException ex)
            {
                _initError = $"Three.js init failed: {ex.Message}";
                _robotReady = false;
            }
        }
        // Paint the Three.js cell first; Motus path-build is CPU-heavy (esp. WASM) and must not
        // block the first interactive frame. Play stays disabled until Build finishes.
        _phase = "Planning Motus path…";
        _robotReady = false; // keep Play disabled while Build runs
        StateHasChanged();
        await Task.Delay(1);
        await RefreshMotionAsync(apply: true);
        _robotReady = true;
        if (string.IsNullOrEmpty(_motionError))
            _phase = _keys.Count > 0 ? BambooIcdMotion.Sample(_keys, 0).Label : "Home";
        StateHasChanged();
        await PushPoseAsync();
        await PushFramesAsync();
    }

    private async Task InitializeRobot()
    {
        try
        {
            var urdfContent = await JS.InvokeAsync<string>("fetchFile", "/fixtures/bamboo_icd/bamboo_icd.urdf");
            // Hung arm + pole/cane/ground/mount CollisionScene; URDF link frames == drawn groups.
            // Truss canes use BambooTrussLayout.StrutLength (bridge edge canes) — drawn == collided.
            _cell = BambooIcdCell.Load(urdfContent, BambooTrussLayout.StrutLength);
            // No hang rod; ground surfaces + pit; the L-grip starts clamped on the A anchor column (grounded base).
            BambooTrussLayout.Configure(_cell);
            _robotReady = true;
            _initError = null;
        }
        catch (Exception ex)
        {
            _robotReady = false;
            _initError = $"Failed to load robot: {ex.Message}";
            _phase = "Init error";
        }
    }

    private async Task RefreshMotionAsync(bool apply)
    {
        // Same Motus cell the 0.5° Play scan uses — required under WASM (planner cannot LoadFile).
        if (_cell is not null)
        {
            var retryDefaults = BambooTrussMotion.ShippedTasksSource == "graph order (cell unavailable)";
            BambooTrussMotion.UseCell(_cell);
            if (retryDefaults) _tasks = BambooTrussMotion.ShippedTasks();
        }
        var built = await BambooTrussMotion.BuildAsync(_tasks, async memberId =>
        {
            _phase = $"Planning {memberId}…";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1);
        }, useCache: true);
        _motionError = built.Error;
        _planNotes = built.Notes.ToList();
        if (built.Grips.Count > 0)
        {
            var worst = built.Grips.Where(g => g.Gripper != "cane").ToList();
            if (worst.Count > 0)
                _planNotes.Add($"Grip FK residual (worst of {worst.Count}): {worst.Max(g => g.PosM) * 1000:F4} mm, {worst.Max(g => g.AxisDeg):F4}° (tolerance {BambooGripKinematics.GripPosTolM * 1000:F1} mm / {BambooGripKinematics.GripAxisTolDeg:F1}°)");
        }
        _keys = built.Keys;
        _cycles = built.Cycles;
        _blocks = BambooTrussTimeline.Blocks(_keys, _cycles);
        _scanCts?.Cancel();
        _trussScan = null;
        _motusNote = "";
        if (_cell is not null)
        {
            _trussScan = new BambooTrussScan(_cell, _keys, _cycles, BambooTrussLayout.Members, _gL);
            if (_trussScan.TrackMiss is { } miss) _motusNote = $"Motus: {miss} — strut stays on the ground.";
            _scanCts = new CancellationTokenSource();
            _ = BackgroundTrussScan(_trussScan, _scanCts.Token);
        }
        if (apply && !_manual)
            ApplyTask(_t);
        else if (_manual)
            RunManualCollision();
    }

    /// <summary>Joint step between Motus checks along the motion (degrees). 0.5° keeps every part from tunnelling.</summary>

    /// <summary>Wall-clock budget per background Motus slice (ms). A fixed sample count could block the
    /// WASM UI thread for seconds in expensive stretches; a time budget keeps every frame paintable.</summary>
    private const double ScanSliceMs = 8;
    /// <summary>Motus budget spent inside each Play frame when playback is waiting on the scan frontier.</summary>
    private const double PlayScanSliceMs = 10;

    private async Task BackgroundTrussScan(BambooTrussScan scan, CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && !scan.Complete)
            {
                scan.StepFor(ScanSliceMs);
                await Task.Delay(1, token);
            }
            if (token.IsCancellationRequested || !ReferenceEquals(scan, _trussScan)) return;
            UpdateScanNote();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void UpdateScanNote()
    {
        if (_trussScan is null) return;
        var miss = _trussScan.TrackMiss is { } m ? $"Motus: {m} — strut stays on the ground. " : "";
        if (_trussScan.FirstHit is { } hit)
            _motusNote = $"{miss}Motus: path collides at {hit.T * 100:F1}% ({hit.Label}): {hit.Describe()}. Play/scrub stop at {Math.Max(0, hit.LastClearT) * 100:F1}%.";
        else
            _motusNote = miss.TrimEnd();
    }

    private void ApplyTask(double t)
    {
        t = Math.Clamp(t, 0, 1);
        BambooTrussScan.Hit? stop = null;
        if (_trussScan is not null && string.IsNullOrEmpty(_motionError))
        {
            _trussScan.AdvanceTo(t);
            if (_trussScan.FirstHit is { } hit && t >= hit.T)
            {
                stop = hit;
                t = Math.Max(0, hit.LastClearT);
            }
        }
        var sample = BambooTrussMotion.SampleState(_keys, t);
        _qDeg = sample.Q;
        _gL = sample.GL;
        _gR = sample.GR;
        _hold = sample.Hold;
        _label = sample.Label;
        _t = t;
        _scrub = (int)Math.Round(t * 1000);
        if (stop is not null)
        {
            _collision = true;
            _contacts = stop.Contacts;
            _motusState = "stopped";
            UpdateScanNote();
            _phase = $"Motus stop · {stop.Label} · {stop.Describe()}";
        }
        else
        {
            _contacts = Array.Empty<CollisionContact>();
            _collision = false;
            _motusState = "clear";
            _phase = string.IsNullOrEmpty(_motionError) ? sample.Label : _motionError;
        }
    }

    private void RunManualCollision()
    {
        if (_cell is null || _trussScan is null) { _collision = false; return; }
        // Manual sliders move the joints about the plan's clamped base at this time (the base never floats).
        _contacts = _trussScan.ContactsAt(_t, _qDeg, _gR, _gL, _hold);
        _collision = _contacts.Count > 0;
        _motusState = _collision ? "manual-hit" : "clear";
        _phase = _collision ? $"Manual · Motus collision · {BambooIcdCell.Describe(_contacts)}" : "Manual";
    }

    private string[] HitParts()
    {
        var names = new List<string>();
        foreach (var c in _contacts) { names.Add(c.BodyA); names.Add(c.BodyB); }
        return names.Distinct().ToArray();
    }

    private async Task PushPoseAsync()
    {
        if (!_threeReady || _cell is null) return;
        object? strut = null;
        object? struts = null;
        object? mount = null;
        object? anchors = null;
        List<string>? hubs = null;
        if (_trussScan is not null)
        {
            hubs = _trussScan.HubsAt(_t, _hold);
            var poses = _trussScan.StrutPoses(_t, _hold, _qDeg);
            struts = poses.Select(p => new { name = p.Name, pose = p.Pose }).ToList();
            // The L-grip (mount) is wherever FK from the clamped base puts it — drawn exactly where Motus collides it.
            var (lw, _) = _trussScan.GrippersAt(_t, _qDeg);
            var f = Transforms.ToFrame(lw);
            mount = new { p = new[] { f.X, f.Y, f.Z }, q = new[] { f.Qx, f.Qy, f.Qz, f.Qw } };
            // A ring + label for every clamped gripper (the base, and the other one too whenever it is clamped).
            anchors = _trussScan.ClampsAt(_t, _qDeg, _gR, _gL).Select(c => new
            {
                gripper = c.Gripper, on = c.On, isBase = c.IsBase, held = c.Held,
                p = new[] { c.Frame[3], c.Frame[7], c.Frame[11] }, axis = new[] { c.Frame[2], c.Frame[6], c.Frame[10] }
            }).ToList();
        }
        var payload = new
        {
            q = _qDeg,
            mount,
            anchors,
            hubs,
            gL = _gL,
            gR = _gR,
            strut,
            struts,
            axesVisible = _axesVisible,
            hitParts = HitParts()
        };
        await JS.InvokeVoidAsync("setBambooPose", JsonSerializer.Serialize(payload));
        // Frame labels only for the member being built (none during start / walk).
        var active = _cycles is { Count: > 0 } c ? c[BambooTrussMotion.MemberIndexAt(c, _t)].MemberId : null;
        if (active is "start" or "walk" or "walk2") active = null;
        if (active != _activeFrameMember || !_activeFramePushed)
        {
            _activeFrameMember = active;
            _activeFramePushed = true;
            await JS.InvokeVoidAsync("setBambooActiveMember", active);
        }
    }

    private string? _activeFrameMember;
    private bool _activeFramePushed;

    private async Task PushFramesAsync()
    {
        if (!_threeReady) return;
        var frames = _tasks.Select(t => new
        {
            id = t.Identity,
            obj = t.Object,
            planes = t.Planes.Select(p => new
            {
                name = p.Name,
                x = p.X,
                y0 = p.Y0,
                z = p.Z,
                pitch = p.PitchDeg,
                yaw = p.YawDeg,
                yMm = p.YMm
            })
        });
        await JS.InvokeVoidAsync("setBambooFrames", JsonSerializer.Serialize(frames));
    }

    private static bool TryParse(ChangeEventArgs e, out double v) =>
        double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out v);

    private async Task OnJoint(int index, ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        StopPlay();
        _manual = true;
        _qDeg[index] = v;
        RunManualCollision();
        await PushPoseAsync();
    }

    private async Task OnGripL(ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        StopPlay();
        _manual = true;
        _gL = v;
        RunManualCollision();
        await PushPoseAsync();
    }

    private async Task OnGripR(ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        StopPlay();
        _manual = true;
        _gR = v;
        RunManualCollision();
        await PushPoseAsync();
    }

    /// <summary>Timeline: clicking a task block jumps to its start (Motus stops still apply via ApplyTask).</summary>
    private async Task JumpTo(double t)
    {
        if (!IsRobotReady) return;
        StopPlay();
        _manual = false;
        ApplyTask(Math.Clamp(t + 1e-9, 0, 1));
        await PushPoseAsync();
    }

    private async Task OnScrub(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        StopPlay();
        _manual = false;
        ApplyTask(v / 1000.0);
        await PushPoseAsync();
    }


    private async Task OnAxesToggle(ChangeEventArgs e)
    {
        _axesVisible = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await PushPoseAsync();
    }

    private async Task TogglePlay()
    {
        if (_isPlaying) { StopPlay(); return; }
        if (!string.IsNullOrEmpty(_motionError))
        {
            _phase = _motionError;
            return;
        }
        _manual = false;
        // Restart from the beginning when at the end or parked on a Motus stop.
        if (_t >= 1 - 1e-9 || _motusState == "stopped") { _t = 0; _scrub = 0; }
        _playback = new BambooTrussPlayback(_keys, _t);
        _isPlaying = true;
        _playCts = new CancellationTokenSource();
        var token = _playCts.Token;
        _ = RunPlayLoop(token);
        await Task.CompletedTask;
    }

    private async Task RunPlayLoop(CancellationToken token)
    {
        var last = DateTime.UtcNow;
        var playback = _playback;
        try
        {
            while (!token.IsCancellationRequested && _isPlaying && playback is not null)
            {
                var now = DateTime.UtcNow;
                var dt = (now - last).TotalSeconds;
                last = now;
                // Motus work per frame is time-boxed: playback waits on the verified frontier instead of
                // forcing the remaining scan synchronously on the UI thread (that froze the page for
                // seconds, then the clock had run past the blocks that were never drawn).
                var frontier = 1.0;
                if (_trussScan is not null && string.IsNullOrEmpty(_motionError))
                {
                    if (!_trussScan.Complete) _trussScan.StepFor(PlayScanSliceMs);
                    frontier = _trussScan.Frontier;
                }
                var t = playback.Advance(dt, frontier);
                if (_trussScan?.FirstHit is { } hit && playback.WaitingForMotus)
                    ApplyTask(hit.T); // parks on LastClearT and shows the Motus stop
                else
                    ApplyTask(t);
                if (playback.WaitingForMotus && _motusState == "clear") _motusState = "checking";
                await PushPoseAsync();
                if (_motusState == "stopped" || playback.Done)
                {
                    StopPlay();
                    StateHasChanged();
                    break;
                }
                StateHasChanged();
                await Task.Delay(16, token);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void StopPlay()
    {
        _isPlaying = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private async Task ResetAll()
    {
        StopPlay();
        _manual = false;
        _tasks = BambooTrussMotion.ShippedTasks();
        _scrub = 0;
        _t = 0;
        _gL = BambooTrussLayout.JawClosedMm;
        await RefreshMotionAsync(apply: true);
        await PushFramesAsync();
        await PushPoseAsync();
    }

    private bool IsMotionTask(int index)
    {
        // Every object-matched pick/place pair participates in the truss motion.
        var t = _tasks[index];
        if (t.Identity == "walk") return true;
        if (t.Identity == "park") return _tasks.Any(o => o.Identity == "pick" && o.Object == t.Object);
        if (t.Identity is not ("pick" or "place")) return false;
        return _tasks.Any(o => o.Identity == (t.Identity == "pick" ? "place" : "pick") && o.Object == t.Object);
    }

    private bool CanDelete(BambooIcdMotion.TaskEdit task)
    {
        var picks = _tasks.Count(t => t.Identity == "pick");
        var places = _tasks.Count(t => t.Identity == "place");
        if (task.Identity == "pick" && picks <= 1) return false;
        if (task.Identity == "place" && places <= 1) return false;
        return true;
    }

    private async Task DuplicateTask(int index)
    {
        var src = _tasks[index];
        var copy = new BambooIcdMotion.TaskEdit
        {
            Identity = src.Identity,
            Gait = src.Gait,
            Object = src.Object,
            JawMm = src.JawMm,
            Planes = src.Planes.Select(p => new BambooIcdMotion.PlaneEdit
            {
                Name = p.Name, X = p.X, Y0 = p.Y0, Z = p.Z, PitchDeg = p.PitchDeg, YawDeg = p.YawDeg, YMm = p.YMm
            }).ToList()
        };
        _tasks.Insert(index + 1, copy);
        await AfterTaskEdit(frames: true);
    }

    private async Task DeleteTask(int index)
    {
        if (!CanDelete(_tasks[index])) return;
        _tasks.RemoveAt(index);
        await AfterTaskEdit(frames: true);
    }

    private async Task AfterTaskEdit(bool frames)
    {
        await RefreshMotionAsync(apply: !_manual);
        if (frames) await PushFramesAsync();
        await PushPoseAsync();
    }

    private void OnGait(int index, ChangeEventArgs e) => _tasks[index].Gait = e.Value?.ToString();

    private async Task OnIdentity(int index, ChangeEventArgs e)
    {
        _tasks[index].Identity = e.Value?.ToString() ?? "";
        await AfterTaskEdit(frames: true);
    }

    private Task OnObject(int index, ChangeEventArgs e)
    {
        _tasks[index].Object = e.Value?.ToString() ?? "";
        return Task.CompletedTask;
    }

    private async Task OnJawMm(int index, ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        _tasks[index].JawMm = v;
        await AfterTaskEdit(frames: false);
    }

    private async Task OnPlaneYMm(int index, string planeName, ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        var plane = _tasks[index].Planes.FirstOrDefault(p => p.Name == planeName);
        if (plane is null) return;
        plane.YMm = v;
        await AfterTaskEdit(frames: true);
    }

    public async ValueTask DisposeAsync()
    {
        StopPlay();
        _scanCts?.Cancel();
        await Task.CompletedTask;
    }

    // ---- Presentation only (ANDURA UI): derived read-only views of existing state; no planner/collision logic. ----
    private bool IsStop => _motusState is "stopped" or "manual-hit";
    private string CautionText => !string.IsNullOrEmpty(_initError) ? _initError!
        : !string.IsNullOrEmpty(_motionError) ? _motionError
        : !IsStop && !string.IsNullOrEmpty(_motusNote) ? _motusNote : "";
    private bool HasAlarm => IsStop || !string.IsNullOrEmpty(CautionText);
    private string StopText => !string.IsNullOrEmpty(_motusNote) && _motusState == "stopped" ? _motusNote : _phase;
    private int MembersTotal => BambooTrussLayout.Members.Count;
    private int MembersDone
    {
        get
        {
            if (_cycles is not { Count: > 0 }) return 0;
            var ids = BambooTrussLayout.Members.Select(m => m.Id).ToHashSet();
            return _cycles.Where(c => ids.Contains(c.MemberId) && c.T1 <= _t + 1e-9).Select(c => c.MemberId).Distinct().Count();
        }
    }
    private string ActiveMemberText
    {
        get
        {
            if (_cycles is not { Count: > 0 }) return "NO PLAN";
            if (_t >= 1 - 1e-9) return "TRUSS COMPLETE";
            var id = _cycles[BambooTrussMotion.MemberIndexAt(_cycles, _t)].MemberId;
            return id is "start" ? "AT START" : id.StartsWith("walk") ? "WALKING" : $"NOW {id}";
        }
    }
    private string StatusTitle => !IsRobotReady ? "Loading Motus.NET…"
        : _manual ? "Manual jog"
        : _t >= 1 - 1e-9 ? "Truss complete"
        : _isPlaying ? "Building" : _t <= 1e-9 ? "Ready to build" : "Paused";
    private static string TaskTitle(BambooIcdMotion.TaskEdit task) =>
        task.Identity == "walk" ? $"Walk → {task.Object}" : task.Identity == "park" ? $"Park {task.Object} → {task.Via}" : $"{task.Identity} {task.Object}";
}
