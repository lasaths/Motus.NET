@page "/bamboo-truss"
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Motus.Core
@using Motus.Geometry
@using Motus.Presets
@using Motus.Viewer.Services
@using System.Text.Json
@using System.Xml.Linq

<PageTitle>Bamboo truss (store → bridge span)</PageTitle>

<div class="viewer-container">
    <div class="viewport-wrap">
        <div id="viewport"></div>
    </div>

    <aside class="controls">
        <h1>Bamboo truss (store → bridge span)</h1>
        <p class="sub">Whole five-member bridge A–D with 0.25 m canes (baseL, baseR, diagL, diagR, sep — all built), then node-transfer walking on it, by a grounded two-gripper arm working from stakes outboard of A. One gripper is always clamped on a real fixed object (stake, or a cane fixed at both ends) and is the IK base; the other moves by joint IK only. Motus.NET owns FK/IK/collision; Three.js only draws.</p>
        <div class="phase @(!string.IsNullOrEmpty(_motionError) || _collision ? "err" : "")" data-motus="@_motusState">@_phase</div>

        <div class="row">
            <label>Motion <span>@_scrubPct%</span></label>
            <input type="range" min="0" max="1000" step="1" value="@_scrub"
                   disabled="@(!IsRobotReady)"
                   @oninput="OnScrub" />
        </div>
        <div class="btns">
            <button type="button" class="@(_isPlaying ? "active" : "")" disabled="@(!IsRobotReady)" @onclick="TogglePlay">
                @(_isPlaying ? "Pause" : "Play")
            </button>
            <button type="button" disabled="@(!IsRobotReady)" @onclick="ResetAll">Reset</button>
        </div>

        <div id="tasks">
            @for (var ti = 0; ti < _tasks.Count; ti++)
            {
                var index = ti;
                var task = _tasks[index];
                var used = IsMotionTask(index);
                var canDelete = CanDelete(task);
                <div class="task">
                    <div class="taskhead">
                        <span>@(task.Identity == "walk" ? $"Walk → {task.Object}" : "Task")</span>
                        <span class="used">@(task.Identity == "walk" ? $"walk · {BambooWalk.GaitNamed(task.Gait).Name}" : used ? "motion" : "")</span>
                    </div>
                    <div class="field">
                        <span>identity</span>
                        <input value="@task.Identity" @oninput="e => OnIdentity(index, e)" />
                    </div>
                    <div class="field">
                        <span>object</span>
                        <input value="@task.Object" @oninput="e => OnObject(index, e)" />
                    </div>
                    <div class="field">
                        <span>jawMm</span>
                        <input type="number" step="1" value="@task.JawMm" @oninput="e => OnJawMm(index, e)" />
                        <em>mm</em>
                    </div>
                    @if (task.Identity == "walk")
                    {
                        <div class="field">
                            <span>gait</span>
                            <select value="@(task.Gait ?? BambooWalk.Default.Id)" @onchange="e => OnGait(index, e)">
                                @foreach (var g in BambooWalk.Gaits)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            </select>
                        </div>
                    }
                    @foreach (var plane in task.Planes)
                    {
                        var pname = plane.Name;
                        <div class="field">
                            <span>@pname</span>
                            <input type="number" step="0.5" title="Nudge @pname along world Y, millimetres"
                                   value="@plane.YMm"
                                   @oninput="e => OnPlaneYMm(index, pname, e)" />
                            <em>mm</em>
                        </div>
                    }
                    <div class="btns">
                        <button type="button" class="mini" @onclick="() => DuplicateTask(index)">Duplicate</button>
                        <button type="button" class="mini" disabled="@(!canDelete)" @onclick="() => DeleteTask(index)">Delete</button>
                    </div>
                </div>
            }
        </div>

        <p class="warn">@_motionError</p>
        @if (_planNotes.Count > 0)
        {
            <ul class="note plan-notes">
                @foreach (var n in _planNotes)
                {
                    <li>@n</li>
                }
            </ul>
        }
        @if (!string.IsNullOrEmpty(_motusNote))
        {
            <p class="warn motus-hit">@_motusNote</p>
        }

        <div>
            @if (!IsRobotReady)
            {
                <div class="joint-loading">@(_initError ?? "Loading Motus.NET…")</div>
            }
            else
            {
                @for (var i = 0; i < 5; i++)
                {
                    var ji = i;
                    <div class="row">
                        <label>θ@(ji + 1) <span>@_qDeg[ji].ToString("F1")°</span></label>
                        <input type="range"
                               min="@BambooIcdMotion.LimitsDeg[ji].Min"
                               max="@BambooIcdMotion.LimitsDeg[ji].Max"
                               step="0.1"
                               value="@_qDeg[ji]"
                               @oninput="e => OnJoint(ji, e)" />
                    </div>
                }
                <div class="row">
                    <label>L-grip <span>@_gL.ToString("F1") mm</span></label>
                    <input type="range" min="8" max="45" step="0.1" value="@_gL" @oninput="OnGripL" />
                </div>
                <div class="row">
                    <label>R-grip <span>@_gR.ToString("F1") mm</span></label>
                    <input type="range" min="8" max="45" step="0.1" value="@_gR" @oninput="OnGripR" />
                </div>
            }
        </div>

        <label class="check">
            <input type="checkbox" checked="@_axesVisible" @onchange="OnAxesToggle" /> Joint axes
        </label>
        <p class="note">
            Drag the view to orbit. Moving a joint or gripper slider pauses playback and drives the arm from C#.
            Play runs every pick/place pair (object = member id). Vertical footprint: A–B–C + B–D–C in the XY plane, B near ground, C apex, shared upright B–C.
            Bend axes local X, wrists local Y, jaws local X. Viewer is Three.js Y-up; Motus.NET URDF is Z-up (shared θ).
            No earth between the anchors: apart from the A/D pads and posts, both stakes and the stock pegs stand outboard of A. Start: L-grip clamped on stake S1 (amber ring + label on every clamped gripper; blue = cane in hand). Walk: R clamps stake S3 low, "swap base L→R", the L clamp slides up off S1 and down onto S3, "swap base R→L", R parks. Then from S3 the R-grip picks each cane off the stock and places it exactly on baseL (A–B), baseR (B–D) — the chord is now fixed at both ends — diagL (A–C), diagR (D–C) and sep (B–C); every placement ends with R parked. Then the robot walks on the finished bridge with node transfer: S3 → baseR's B end → (R on sep) baseL's B end → across B onto baseR → back to S3. Canes are 0.25 m: at 0.30 m sep and diagR have no Motus-clear grasp/carry from any allowed support.
            Collision: Motus.NET for every link, both grippers, the mount, the held cane, pads, posts, stakes, rail, placed canes and self; the only allowed touch is a gripper's jaw plates on what it clamps. Play/scrub never pass the Motus-verified frontier.
        </p>
    </aside>
</div>

@code {
    private List<string> _planNotes = new();
    private BambooIcdCell? _cell;
    private CancellationTokenSource? _scanCts;

    private List<BambooIcdMotion.TaskEdit> _tasks = BambooTrussMotion.ShippedTasks();
    private List<BambooIcdMotion.MotionKey> _keys = new();
    private List<BambooTrussMotion.CycleBound> _cycles = new();
    private BambooTrussScan? _trussScan;
    private string _motionError = "";
    private string _motusNote = "";

    private double[] _qDeg = BambooIcdMotion.HomeDeg.ToArray();
    private double _gL = BambooTrussLayout.JawClosedMm;
    private double _gR = 40;
    private int _hold;
    private string _label = "Home";
    private bool _axesVisible = true;
    private bool _collision;
    private IReadOnlyList<CollisionContact> _contacts = Array.Empty<CollisionContact>();
    private string _phase = "Home";
    private int _scrub;
    /// <summary>Exact motion time (0..1); <see cref="_scrub"/> is only the slider's rounded view of it.</summary>
    private double _t;
    private BambooTrussPlayback? _playback;
    private int _scrubPct => (int)Math.Round(_scrub / 10.0);
    private bool _isPlaying;
    private bool _manual;
    private bool _robotReady;
    private string? _initError;
    private bool _threeReady;
    private CancellationTokenSource? _playCts;

    /// <summary>Plain-text status for automation / screenshots: clear | stopped | manual-hit.</summary>
    private string _motusState = "clear";

    private bool IsRobotReady =>
        _robotReady && _qDeg.Length >= 5 && _threeReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await InitializeRobot();
        if (_cell is not null)
        {
            try
            {
                var merged = new Dictionary<string, object?>
                {
                    ["seg"] = _cell.Seg,
                    ["poleY"] = BambooIcdMotion.PoleY,
                    ["includePole"] = false,
                    ["pole"] = new { radius = BambooIcdCell.PoleRadius, length = BambooIcdCell.PoleLength, segments = BambooIcdCell.PoleSegments },
                    ["strut"] = new { radius = BambooIcdCell.StrutRadius, length = _cell.StrutLen, segments = BambooIcdCell.StrutSegments },
                    // Motus collides pads only (anchors, stakes, stock feed): draw exactly those, not a full slab.
                    ["ground"] = new
                    {
                        size = BambooIcdCell.GroundSize,
                        pads = BambooTrussLayout.Pads.Select(p => new { name = p.Name, x = p.X, z = p.Z, half = Math.Max(p.HalfX, p.HalfZ), halfX = p.HalfX, halfZ = p.HalfZ }).ToArray()
                    },
                    ["posts"] = BambooTrussLayout.Posts.Select(p => new { name = p.Name, x = p.X, z = p.Z, top = p.Top, radius = p.Radius }).ToArray(),
                    ["pit"] = BambooTrussLayout.PitBoxes.Select(b => new { name = b.Name, x = b.X, y = b.Y, z = b.Z, halfX = b.HalfX, halfY = b.HalfY, halfZ = b.HalfZ }).ToArray(),
                    ["hubs"] = BambooTrussLayout.FootNodes.Select(n => new { node = n.Name, x = n.X, y = n.Y, z = n.Z, half = BambooTrussLayout.HubHalf, @fixed = n.Name is "A" or "D" }).ToArray(),
                    ["racks"] = BambooTrussLayout.Racks.Select(r => new { name = r.Name, x = r.X, z = r.Z, halfX = r.HalfX, halfZ = r.HalfZ, top = r.Top }).ToArray(),
                    ["parts"] = _cell.Parts.Select(p => new { name = p.Name, link = p.Link, size = p.Size, pos = p.Pos }),
                    ["footprint"] = BambooTrussLayout.FootprintDescription(),
                    ["store"] = BambooTrussLayout.StoreDescription()
                };
                await JS.InvokeVoidAsync("initThreeJs", JsonSerializer.Serialize(merged));
                _threeReady = true;
            }
            catch (JSException ex)
            {
                _initError = $"Three.js init failed: {ex.Message}";
                _robotReady = false;
            }
        }
        // Paint the Three.js cell first; Motus path-build is CPU-heavy (esp. WASM) and must not
        // block the first interactive frame. Play stays disabled until Build finishes.
        _phase = "Planning Motus path…";
        _robotReady = false; // keep Play disabled while Build runs
        StateHasChanged();
        await Task.Delay(1);
        await RefreshMotionAsync(apply: true);
        _robotReady = true;
        if (string.IsNullOrEmpty(_motionError))
            _phase = _keys.Count > 0 ? BambooIcdMotion.Sample(_keys, 0).Label : "Home";
        StateHasChanged();
        await PushPoseAsync();
        await PushFramesAsync();
    }

    private async Task InitializeRobot()
    {
        try
        {
            var urdfContent = await JS.InvokeAsync<string>("fetchFile", "/fixtures/bamboo_icd/bamboo_icd.urdf");
            // Hung arm + pole/cane/ground/mount CollisionScene; URDF link frames == drawn groups.
            // Truss canes use BambooTrussLayout.StrutLength (bridge edge canes) — drawn == collided.
            _cell = BambooIcdCell.Load(urdfContent, BambooTrussLayout.StrutLength);
            // No hang rod, pads only; the L-grip starts clamped on anchor stake S1 (grounded base).
            BambooTrussLayout.Configure(_cell);
            _robotReady = true;
            _initError = null;
        }
        catch (Exception ex)
        {
            _robotReady = false;
            _initError = $"Failed to load robot: {ex.Message}";
            _phase = "Init error";
        }
    }

    private async Task RefreshMotionAsync(bool apply)
    {
        // Same Motus cell the 0.5° Play scan uses — required under WASM (planner cannot LoadFile).
        if (_cell is not null) BambooTrussMotion.UseCell(_cell);
        var built = await BambooTrussMotion.BuildAsync(_tasks, async memberId =>
        {
            _phase = $"Planning {memberId}…";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1);
        }, useCache: true);
        _motionError = built.Error;
        _planNotes = built.Notes.ToList();
        if (built.Grips.Count > 0)
        {
            var worst = built.Grips.Where(g => g.Gripper != "cane").ToList();
            if (worst.Count > 0)
                _planNotes.Add($"Grip FK residual (worst of {worst.Count}): {worst.Max(g => g.PosM) * 1000:F4} mm, {worst.Max(g => g.AxisDeg):F4}° (tolerance {BambooGripKinematics.GripPosTolM * 1000:F1} mm / {BambooGripKinematics.GripAxisTolDeg:F1}°)");
        }
        _keys = built.Keys;
        _cycles = built.Cycles;
        _scanCts?.Cancel();
        _trussScan = null;
        _motusNote = "";
        if (_cell is not null)
        {
            _trussScan = new BambooTrussScan(_cell, _keys, _cycles, BambooTrussLayout.Members, _gL, BambooViewerScanStepDeg);
            if (_trussScan.TrackMiss is { } miss) _motusNote = $"Motus: {miss} — strut stays on the ground.";
            _scanCts = new CancellationTokenSource();
            _ = BackgroundTrussScan(_trussScan, _scanCts.Token);
        }
        if (apply && !_manual)
            ApplyTask(_t);
        else if (_manual)
            RunManualCollision();
    }

    /// <summary>Joint step between Motus checks along the motion (degrees). 0.5° keeps every part from tunnelling.</summary>
    private const double BambooViewerScanStepDeg = 0.5;

    /// <summary>Wall-clock budget per background Motus slice (ms). A fixed sample count could block the
    /// WASM UI thread for seconds in expensive stretches; a time budget keeps every frame paintable.</summary>
    private const double ScanSliceMs = 8;
    /// <summary>Motus budget spent inside each Play frame when playback is waiting on the scan frontier.</summary>
    private const double PlayScanSliceMs = 10;

    private async Task BackgroundTrussScan(BambooTrussScan scan, CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && !scan.Complete)
            {
                scan.StepFor(ScanSliceMs);
                await Task.Delay(1, token);
            }
            if (token.IsCancellationRequested || !ReferenceEquals(scan, _trussScan)) return;
            UpdateScanNote();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void UpdateScanNote()
    {
        if (_trussScan is null) return;
        var miss = _trussScan.TrackMiss is { } m ? $"Motus: {m} — strut stays on the ground. " : "";
        if (_trussScan.FirstHit is { } hit)
            _motusNote = $"{miss}Motus: path collides at {hit.T * 100:F1}% ({hit.Label}): {hit.Describe()}. Play/scrub stop at {Math.Max(0, hit.LastClearT) * 100:F1}%.";
        else
            _motusNote = miss.TrimEnd();
    }

    private void ApplyTask(double t)
    {
        t = Math.Clamp(t, 0, 1);
        BambooTrussScan.Hit? stop = null;
        if (_trussScan is not null && string.IsNullOrEmpty(_motionError))
        {
            _trussScan.AdvanceTo(t);
            if (_trussScan.FirstHit is { } hit && t >= hit.T)
            {
                stop = hit;
                t = Math.Max(0, hit.LastClearT);
            }
        }
        var sample = BambooTrussMotion.SampleState(_keys, t);
        _qDeg = sample.Q;
        _gL = sample.GL;
        _gR = sample.GR;
        _hold = sample.Hold;
        _label = sample.Label;
        _t = t;
        _scrub = (int)Math.Round(t * 1000);
        if (stop is not null)
        {
            _collision = true;
            _contacts = stop.Contacts;
            _motusState = "stopped";
            UpdateScanNote();
            _phase = $"Motus stop · {stop.Label} · {stop.Describe()}";
        }
        else
        {
            _contacts = Array.Empty<CollisionContact>();
            _collision = false;
            _motusState = "clear";
            _phase = string.IsNullOrEmpty(_motionError) ? sample.Label : _motionError;
        }
    }

    private void RunManualCollision()
    {
        if (_cell is null || _trussScan is null) { _collision = false; return; }
        // Manual sliders move the joints about the plan's clamped base at this time (the base never floats).
        _contacts = _trussScan.ContactsAt(_t, _qDeg, _gR, _gL, _hold);
        _collision = _contacts.Count > 0;
        _motusState = _collision ? "manual-hit" : "clear";
        _phase = _collision ? $"Manual · Motus collision · {BambooIcdCell.Describe(_contacts)}" : "Manual";
    }

    private string[] HitParts()
    {
        var names = new List<string>();
        foreach (var c in _contacts) { names.Add(c.BodyA); names.Add(c.BodyB); }
        return names.Distinct().ToArray();
    }

    private async Task PushPoseAsync()
    {
        if (!_threeReady || _cell is null) return;
        object? strut = null;
        object? struts = null;
        object? mount = null;
        object? anchors = null;
        List<string>? hubs = null;
        if (_trussScan is not null)
        {
            hubs = _trussScan.HubsAt(_t, _hold);
            var poses = _trussScan.StrutPoses(_t, _hold, _qDeg);
            struts = poses.Select(p => new { name = p.Name, pose = p.Pose }).ToList();
            // The L-grip (mount) is wherever FK from the clamped base puts it — drawn exactly where Motus collides it.
            var (lw, _) = _trussScan.GrippersAt(_t, _qDeg);
            var f = Transforms.ToFrame(lw);
            mount = new { p = new[] { f.X, f.Y, f.Z }, q = new[] { f.Qx, f.Qy, f.Qz, f.Qw } };
            // A ring + label for every clamped gripper (the base, and the other one too whenever it is clamped).
            anchors = _trussScan.ClampsAt(_t, _qDeg, _gR, _gL).Select(c => new
            {
                gripper = c.Gripper, on = c.On, isBase = c.IsBase, held = c.Held,
                p = new[] { c.Frame[3], c.Frame[7], c.Frame[11] }, axis = new[] { c.Frame[2], c.Frame[6], c.Frame[10] }
            }).ToList();
        }
        var payload = new
        {
            q = _qDeg,
            mount,
            anchors,
            hubs,
            gL = _gL,
            gR = _gR,
            strut,
            struts,
            axesVisible = _axesVisible,
            hitParts = HitParts()
        };
        await JS.InvokeVoidAsync("setBambooPose", JsonSerializer.Serialize(payload));
        // Frame labels only for the member being built (none during start / walk).
        var active = _cycles is { Count: > 0 } c ? c[BambooTrussMotion.MemberIndexAt(c, _t)].MemberId : null;
        if (active is "start" or "walk" or "walk2") active = null;
        if (active != _activeFrameMember || !_activeFramePushed)
        {
            _activeFrameMember = active;
            _activeFramePushed = true;
            await JS.InvokeVoidAsync("setBambooActiveMember", active);
        }
    }

    private string? _activeFrameMember;
    private bool _activeFramePushed;

    private async Task PushFramesAsync()
    {
        if (!_threeReady) return;
        var frames = _tasks.Select(t => new
        {
            id = t.Identity,
            obj = t.Object,
            planes = t.Planes.Select(p => new
            {
                name = p.Name,
                x = p.X,
                y0 = p.Y0,
                z = p.Z,
                pitch = p.PitchDeg,
                yaw = p.YawDeg,
                yMm = p.YMm
            })
        });
        await JS.InvokeVoidAsync("setBambooFrames", JsonSerializer.Serialize(frames));
    }

    private static bool TryParse(ChangeEventArgs e, out double v) =>
        double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out v);

    private async Task OnJoint(int index, ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        StopPlay();
        _manual = true;
        _qDeg[index] = v;
        RunManualCollision();
        await PushPoseAsync();
    }

    private async Task OnGripL(ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        StopPlay();
        _manual = true;
        _gL = v;
        RunManualCollision();
        await PushPoseAsync();
    }

    private async Task OnGripR(ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        StopPlay();
        _manual = true;
        _gR = v;
        RunManualCollision();
        await PushPoseAsync();
    }

    private async Task OnScrub(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var v)) return;
        StopPlay();
        _manual = false;
        ApplyTask(v / 1000.0);
        await PushPoseAsync();
    }


    private async Task OnAxesToggle(ChangeEventArgs e)
    {
        _axesVisible = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        await PushPoseAsync();
    }

    private async Task TogglePlay()
    {
        if (_isPlaying) { StopPlay(); return; }
        if (!string.IsNullOrEmpty(_motionError))
        {
            _phase = _motionError;
            return;
        }
        _manual = false;
        // Restart from the beginning when at the end or parked on a Motus stop.
        if (_t >= 1 - 1e-9 || _motusState == "stopped") { _t = 0; _scrub = 0; }
        _playback = new BambooTrussPlayback(_keys, _t);
        _isPlaying = true;
        _playCts = new CancellationTokenSource();
        var token = _playCts.Token;
        _ = RunPlayLoop(token);
        await Task.CompletedTask;
    }

    private async Task RunPlayLoop(CancellationToken token)
    {
        var last = DateTime.UtcNow;
        var playback = _playback;
        try
        {
            while (!token.IsCancellationRequested && _isPlaying && playback is not null)
            {
                var now = DateTime.UtcNow;
                var dt = (now - last).TotalSeconds;
                last = now;
                // Motus work per frame is time-boxed: playback waits on the verified frontier instead of
                // forcing the remaining scan synchronously on the UI thread (that froze the page for
                // seconds, then the clock had run past the blocks that were never drawn).
                var frontier = 1.0;
                if (_trussScan is not null && string.IsNullOrEmpty(_motionError))
                {
                    if (!_trussScan.Complete) _trussScan.StepFor(PlayScanSliceMs);
                    frontier = _trussScan.Frontier;
                }
                var t = playback.Advance(dt, frontier);
                if (_trussScan?.FirstHit is { } hit && playback.WaitingForMotus)
                    ApplyTask(hit.T); // parks on LastClearT and shows the Motus stop
                else
                    ApplyTask(t);
                if (playback.WaitingForMotus && _motusState == "clear") _motusState = "checking";
                await PushPoseAsync();
                if (_motusState == "stopped" || playback.Done)
                {
                    StopPlay();
                    StateHasChanged();
                    break;
                }
                StateHasChanged();
                await Task.Delay(16, token);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void StopPlay()
    {
        _isPlaying = false;
        _playCts?.Cancel();
        _playCts = null;
    }

    private async Task ResetAll()
    {
        StopPlay();
        _manual = false;
        _tasks = BambooTrussMotion.ShippedTasks();
        _scrub = 0;
        _t = 0;
        _gL = BambooTrussLayout.JawClosedMm;
        await RefreshMotionAsync(apply: true);
        await PushFramesAsync();
        await PushPoseAsync();
    }

    private bool IsMotionTask(int index)
    {
        // Every object-matched pick/place pair participates in the truss motion.
        var t = _tasks[index];
        if (t.Identity == "walk") return true;
        if (t.Identity is not ("pick" or "place")) return false;
        return _tasks.Any(o => o.Identity == (t.Identity == "pick" ? "place" : "pick") && o.Object == t.Object);
    }

    private bool CanDelete(BambooIcdMotion.TaskEdit task)
    {
        var picks = _tasks.Count(t => t.Identity == "pick");
        var places = _tasks.Count(t => t.Identity == "place");
        if (task.Identity == "pick" && picks <= 1) return false;
        if (task.Identity == "place" && places <= 1) return false;
        return true;
    }

    private async Task DuplicateTask(int index)
    {
        var src = _tasks[index];
        var copy = new BambooIcdMotion.TaskEdit
        {
            Identity = src.Identity,
            Gait = src.Gait,
            Object = src.Object,
            JawMm = src.JawMm,
            Planes = src.Planes.Select(p => new BambooIcdMotion.PlaneEdit
            {
                Name = p.Name, X = p.X, Y0 = p.Y0, Z = p.Z, PitchDeg = p.PitchDeg, YawDeg = p.YawDeg, YMm = p.YMm
            }).ToList()
        };
        _tasks.Insert(index + 1, copy);
        await AfterTaskEdit(frames: true);
    }

    private async Task DeleteTask(int index)
    {
        if (!CanDelete(_tasks[index])) return;
        _tasks.RemoveAt(index);
        await AfterTaskEdit(frames: true);
    }

    private async Task AfterTaskEdit(bool frames)
    {
        await RefreshMotionAsync(apply: !_manual);
        if (frames) await PushFramesAsync();
        await PushPoseAsync();
    }

    private void OnGait(int index, ChangeEventArgs e) => _tasks[index].Gait = e.Value?.ToString();

    private async Task OnIdentity(int index, ChangeEventArgs e)
    {
        _tasks[index].Identity = e.Value?.ToString() ?? "";
        await AfterTaskEdit(frames: true);
    }

    private Task OnObject(int index, ChangeEventArgs e)
    {
        _tasks[index].Object = e.Value?.ToString() ?? "";
        return Task.CompletedTask;
    }

    private async Task OnJawMm(int index, ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        _tasks[index].JawMm = v;
        await AfterTaskEdit(frames: false);
    }

    private async Task OnPlaneYMm(int index, string planeName, ChangeEventArgs e)
    {
        if (!TryParse(e, out var v)) return;
        var plane = _tasks[index].Planes.FirstOrDefault(p => p.Name == planeName);
        if (plane is null) return;
        plane.YMm = v;
        await AfterTaskEdit(frames: true);
    }

    public async ValueTask DisposeAsync()
    {
        StopPlay();
        _scanCts?.Cancel();
        await Task.CompletedTask;
    }
}
