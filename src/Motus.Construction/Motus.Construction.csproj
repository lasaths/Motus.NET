<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Robotic assembly planning for Motus.NET: a structure/assembly planner (pick, carry, place, walk) with Motus collision checking, shipped with the bamboo Warren-truss example.</Description>
    <PackageTags>robotics;assembly-planning;construction;motion-planning;collision;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Motus.Core\Motus.Core.csproj" />
    <ProjectReference Include="..\Motus.Geometry\Motus.Geometry.csproj" />
    <ProjectReference Include="..\Motus.Presets\Motus.Presets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped default plan (BambooTrussMotion.LoadCachedDefaultPlan). -->
    <EmbeddedResource Include="Bamboo/BambooTrussDefaultPlan.json" LogicalName="Motus.Construction.BambooTrussDefaultPlan.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Motus.Viewer" />
    <InternalsVisibleTo Include="Motus.Core.Tests" />
  </ItemGroup>

</Project>
